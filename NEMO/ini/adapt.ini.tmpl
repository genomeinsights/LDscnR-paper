## ---------------------------------------------------------------------------
## Adapt phase. 1000 generations from the burn-in binary, under the env optimum.
## Mirrors the production bgs2 runs exactly except for the deleterious block.
##
## source_parameter_override delet_effects carries the per-locus s draws over
## from the burn-in, so selection acts on the same loci throughout. Without it
## Nemo would redraw the DFE and the adapt phase would select on a different
## genetic architecture than the one the burn-in equilibrated.
##
## files_genotyper_trim_maf 0 keeps every SEGREGATING site and drops only the
## monomorphic ones -- despite the warning Nemo prints ("value 0.000000 ...
## cannot be used for trimming"), which is harmless. Measured: 10938 markers at
## 0 vs 3258 at 0.01 on the same run. bgs2 used 0.01, which conditions on
## frequency and biases mean He upward exactly where BGS is strongest. Nothing
## is lost by writing more: the analysis pipeline applies its own MAF filter
## after subsampling.
## ---------------------------------------------------------------------------

filename        adapt___TAG___chr__CHR___V__V___c__C___env__ENV__
generations     1000
replicates      1
random_seed     __SEED__
root_dir        __ROOT__
run_mode        overwrite

patch_capacity  8
patch_number    2304

source_pop                __SOURCE__
source_preserve           1
source_replicate_digit    1
source_replicates         1
__SOURCE_OVERRIDE__
ntrl_all                      2
ntrl_genetic_map              &__PARAMS__/map_ntrl__CHR__.txt
ntrl_genetic_map_resolution   3.3e-5
ntrl_init_model               0
ntrl_loci                     999699
ntrl_mutation_model           1
ntrl_mutation_rate            5e-7

__DELET__
quanti_allele_model             diallelic
quanti_allele_value             &__PARAMS__/allelic_values___CHR__.txt
quanti_genetic_map              &__PARAMS__/map_QTN__CHR__.txt
quanti_genetic_map_resolution   3.3e-5
quanti_init_model               2
quanti_loci                     101
quanti_mutation_rate            1e-7
quanti_traits                   1

store             5
store_dir         binary
store_generation  1000
store_noarchive   1

save_stats          3
stat                pop adlt.fstat adlt.quanti __STAT_DELET__fitness adlt.quanti.patch
stat_dir            stats
stat_log_time       1000
stat_output_compact 1

files_genotyper_dir        GENO
files_genotyper_format     snp_genotype
files_genotyper_logtime    1000
files_genotyper_traits     __GENOTYPER_TRAITS__
files_genotyper_trim_maf   __TRIM_MAF__
files_sample_patch         __SAMPLE_PATCH__
files_sample_size          2
save_files                 4

aging                     2
breed_disperse_matrix     &__PARAMS__/disp_mat___C__.txt
breed_selection_disperse  1
mating_system             1
selection_local_optima    &__PARAMS__/env___ENV__.txt
selection_model           __SEL_MODEL__
selection_trait           __SEL_TRAIT__
selection_trait_dimension 1
selection_variance        __V__
