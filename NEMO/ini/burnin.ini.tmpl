## ---------------------------------------------------------------------------
## Burn-in. Flat phenotypic optimum, no genotype output; the only product is the
## binary population at __GENERATIONS__ that the adapt phase reads as source_pop.
##
## Deleterious selection MUST be present here, not only in the adapt phase: the
## adapt phase is 1000 generations ~ 0.05 Ne, so the diversity landscape the
## analysis sees is inherited wholesale from this run. Changing delet_* only in
## the adapt phase produces almost nothing whatever the values.
##
## The bgs and nobgs arms use this same template, and the deleterious block is
## the only thing that differs, so the two arms are identical by construction
## everywhere else -- which is what makes B_obs = pi_bgs/pi_nobgs a clean paired
## contrast. Run both arms with the same Nemo binary: v2.4.0/2.4.1 carry the
## RandBool() defect fixed in 2.4.2, and the existing nobgs set (v2.4.1) is not
## comparable with the existing bgs2 set (v2.4.3) for that reason.
## ---------------------------------------------------------------------------

filename        __TAG___chr__CHR___V__V___c__C___rep1
generations     __GENERATIONS__
replicates      1
random_seed     __SEED__
root_dir        __ROOT__
run_mode        overwrite

patch_capacity  8
patch_number    2304

ntrl_all                      2
ntrl_genetic_map              &__PARAMS__/map_ntrl__CHR__.txt
ntrl_genetic_map_resolution   3.3e-5
ntrl_init_model               0
ntrl_loci                     999699
ntrl_mutation_model           1
ntrl_mutation_rate            5e-7

__DELET__
quanti_allele_model             diallelic
quanti_allele_value             &__PARAMS__/allelic_values___CHR__.txt
quanti_genetic_map              &__PARAMS__/map_QTN__CHR__.txt
quanti_genetic_map_resolution   3.3e-5
quanti_init_model               2
quanti_loci                     101
quanti_mutation_rate            1e-7
quanti_traits                   1

store             5
store_dir         binary
store_generation  __GENERATIONS__
store_noarchive   1

save_stats          3
stat                pop adlt.fstat adlt.quanti __STAT_DELET__fitness
stat_dir            stats
stat_log_time       500
stat_output_compact 1

aging                     2
breed_disperse_matrix     &__PARAMS__/disp_mat___C__.txt
breed_selection_disperse  1
mating_system             1
selection_local_optima    {{1}}
selection_model           __SEL_MODEL__
selection_trait           __SEL_TRAIT__
selection_trait_dimension 1
selection_variance        __V__
